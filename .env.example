# Required: OpenAI-compatible hosted LLM (base URL must include /v1)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=openai/gpt-oss-120b
# Optional for local vLLM; set the real gateway key when authentication is enabled.
LLM_API_KEY=not-needed
# Keep enabled for constrained vLLM tool-call envelopes and JSON arguments.
LLM_STRICT_TOOL_CALLS=true
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=1

# Required: Worxstream API (or set via POST /api/auth/session after login)
WORXSTREAM_BASE_URL=
WORXSTREAM_API_TOKEN=
DEFAULT_COMPANY_ID=
DEFAULT_USER_ID=

# Required: Server
PORT=3000
NODE_ENV=development

# Required: Database
MONGODB_URL=

# Optional: Redis / Valkey (conversation context + estimates tool cache). Omit all to disable.
# Option A — single URL (use rediss:// for TLS, e.g. DigitalOcean managed Valkey on port 25061):
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-host.digitalocean.com:25061
# Option B — discrete fields (password URL-encoded automatically; TLS auto for port 25061):
# REDIS_HOST=
# REDIS_PORT=25061
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=true
# REDIS_DB=
# REDIS_CONTEXT_TTL_SECONDS=1800
# REDIS_CACHE_TTL_SECONDS=60
# REDIS_TLS_REJECT_UNAUTHORIZED=false

# Required in production: public URL of this API and allowed CORS origins
BACKEND_URL=
CORS_ORIGINS=

# Optional: use PUBLIC_URL instead of BACKEND_URL
# PUBLIC_URL=

# Optional: context window limits
MAX_CONTEXT_MESSAGES=50
MAX_CONTEXT_TOKENS=150000
RESERVE_TOKENS=10000

# Dynamic tool selection is implemented by the application before sending
# native OpenAI function definitions to the hosted model.
COWORKER_MAX_TOOLS_PER_TURN=40

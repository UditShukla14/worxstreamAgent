# Required: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required: Worxstream API base URL
WORXSTREAM_BASE_URL=

# Optional: server-side WorxStream API token for Scribe scheduled reports / webhook enrichment.
# Company and user always come from the logged-in caller (or webhook payload) — do NOT set DEFAULT_*.
# WORXSTREAM_API_TOKEN=

# Optional: pause between Scribe show API calls per document (ms, default 200)
# REPORT_DETAIL_REQUEST_GAP_MS=200

# Required: Server
PORT=3000
NODE_ENV=development

# Required: Database (include DB name worxagent in the path, e.g. mongodb://…/worxagent)
MONGODB_URL=

# Platform admin (token usage billing UI /api/admin/*)
ADMIN_API_KEY=

# Optional: Anthropic USD per 1M tokens (defaults = Sonnet list prices)
# ANTHROPIC_PRICE_INPUT_PER_MTOK=3
# ANTHROPIC_PRICE_OUTPUT_PER_MTOK=15
# ANTHROPIC_PRICE_CACHE_WRITE_PER_MTOK=3.75
# ANTHROPIC_PRICE_CACHE_READ_PER_MTOK=0.30

# Optional: Redis / Valkey (conversation context + estimates tool cache). Omit all to disable.
# Option A — single URL (use rediss:// for TLS, e.g. DigitalOcean managed Valkey on port 25061):
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-host.digitalocean.com:25061
# Option B — discrete fields (password URL-encoded automatically; TLS auto for port 25061):
# REDIS_HOST=
# REDIS_PORT=25061
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# REDIS_TLS=true
# REDIS_DB=
# REDIS_CONTEXT_TTL_SECONDS=1800
# REDIS_CACHE_TTL_SECONDS=60
# REDIS_TLS_REJECT_UNAUTHORIZED=false

# Required in production: public URL of this API and allowed CORS origins
BACKEND_URL=
CORS_ORIGINS=

# Optional: use PUBLIC_URL instead of BACKEND_URL
# PUBLIC_URL=

# Optional: context window limits
MAX_CONTEXT_MESSAGES=50
MAX_CONTEXT_TOKENS=150000
RESERVE_TOKENS=10000

# Optional: force tool search on/off (auto-detected by model if unset)
# ANTHROPIC_USE_TOOL_SEARCH=true

# Optional: coworker chat mode (default orchestrator = one Nova + tools, Claude/OpenAI-style)
# COWORKER_MODE=orchestrator
# COWORKER_MODE=specialists

# Optional: max rows per list_* page (default 25). Multi-page dumps are disabled.
# AGENT_MAX_LIST_PAGE_SIZE=25

# Optional: pause write tools until the user confirms in the UI (recommended for SMS)
# COWORKER_CONFIRM_WRITES=true
# COWORKER_PENDING_CONFIRM_TTL=300

# Telnyx SMS (Nova draft_sms → send_sms)
# US/CA/PR (+1): TELNYX_FROM_NUMBER (purchased long code). Alpha is NOT allowed for +1.
# International: TELNYX_ALPHA_SENDER + TELNYX_MESSAGING_PROFILE_ID (e.g. Worxstream).
# TELNYX_API_KEY=
# TELNYX_FROM_NUMBER=+15551234567
# TELNYX_MESSAGING_PROFILE_ID=
# TELNYX_US_MESSAGING_PROFILE_ID=
# TELNYX_ALPHA_SENDER=
# TELNYX_SMS_DRAFT_TTL=600

# Required in production: shared secret for POST /api/webhooks/worxstream
# Accepts X-Worxstream-Webhook-Secret (current WorxStream) or HMAC-SHA256
# over the raw body in X-Worxstream-Signature (sha256=<hex>).
WORXSTREAM_WEBHOOK_SECRET=
